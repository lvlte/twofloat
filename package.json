{
  "name": "twofloat",
  "version": "0.1.0",
  "description": "Double-double (106-bit) floating-point arithmetic for TypeScript and JavaScript",
  "license": "MIT",
  "author": "Eric Lavault <lvlte.code@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlte/twofloat.git"
  },
  "bugs": {
    "url": "https://github.com/lvlte/twofloat/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18.20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test:clean": "rm -Rf ./test/accuracy/pre/output && mkdir \"./test/accuracy/pre/output\"",
    "test:prejl": "tsx ./test/accuracy/prerun.ts",
    "test:jl": "julia ./test/accuracy/runtests.jl",
    "pretest": "npm run test:clean && npm run test:prejl",
    "test": "jest --verbose && npm run test:jl",
    "prebuild": "rm -Rf dist && mkdir dist",
    "build:esm": "tsc && tsc -d --emitDeclarationOnly true --removeComments false",
    "build:cjs": "tsc -p tsconfig-cjs.json && tsc -p tsconfig-cjs.json -d --emitDeclarationOnly true --removeComments false",
    "build": "npm run build:esm && npm run build:cjs",
    "postbuild": "(echo { && echo   \"type\": \"commonjs\" && echo }) > ./dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "double",
    "precision",
    "number",
    "float64",
    "f64",
    "float128",
    "twice",
    "quad",
    "IEEE754",
    "math"
  ],
  "devDependencies": {
    "@lvlte/tsconfig": "^1.2.1",
    "@lvlte/ulp": "^1.3.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "pure-rand": "^8.4.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild@0.28.2": true,
    "unrs-resolver": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
