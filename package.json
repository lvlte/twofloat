{
  "name": "twofloat",
  "version": "0.4.0",
  "description": "Double-double (106-bit) floating-point arithmetic for TypeScript and JavaScript",
  "license": "MIT",
  "author": "Eric Lavault <lvlte.code@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlte/twofloat.git"
  },
  "bugs": {
    "url": "https://github.com/lvlte/twofloat/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "unpkg": "./dist/umd/twofloat.min.js",
  "jsdelivr": "./dist/umd/twofloat.min.js",
  "engines": {
    "node": ">=18.20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0",
      "onFail": "warn"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tscheck": "tsc --noEmit && tsc -p ./test/tsconfig.json",
    "test:clean": "rm -Rf ./test/accuracy/pre/output && mkdir \"./test/accuracy/pre/output\"",
    "test:unit": "jest --verbose",
    "test:prejl": "tsx ./test/accuracy/prerun.ts",
    "test:jl": "julia --project=. ./test/accuracy/runtests.jl",
    "test:nojl": "npm run pretest && npm run test:unit",
    "pretest": "npm run tscheck && npm run lint && npm run test:clean",
    "test": "npm run test:unit && npm run test:prejl && npm run test:jl",
    "prebuild": "rm -Rf dist && mkdir dist",
    "build": "tsdown",
    "postbuild": "echo { \"type\": \"commonjs\" } > ./dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build",
    "lint": "xo --quiet",
    "lint:fix": "xo --fix --quiet"
  },
  "keywords": [
    "double-double",
    "extended-precision",
    "arithmetic",
    "number",
    "float64",
    "float128",
    "quad",
    "IEEE 754",
    "math"
  ],
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@lvlte/tsconfig": "^1.3.0",
    "@lvlte/ulp": "^1.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "oxc-minify": "^0.150.0",
    "pure-rand": "^8.4.2",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "overrides": {
    "xo": {
      "@stylistic/eslint-plugin": "^6.0.0-beta.6",
      "katex": "^0.18.2"
    },
    "jest": {
      "deepmerge": "4.1.2",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
